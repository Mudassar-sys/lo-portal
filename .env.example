# Copy to .env.local and fill in from the Supabase dashboard.
#
# Anything beginning .env is gitignored except this file, and the guard
# refuses any tracked or staged environment file under any name. No value is
# ever written here.

# Settings, Data API, Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Settings, API Keys, publishable key. Starts sb_publishable_.
# Safe in a browser bundle. This replaces the deprecated legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Settings, API Keys, secret keys. Starts sb_secret_.
# Server side only. It bypasses row level security, so no request path is
# allowed to touch it: it is read by scripts/seed-users.mjs and by nothing
# else. This replaces the deprecated legacy service_role key.
SUPABASE_SECRET_KEY=

# Settings, Database, connection string. Used by npm run test:schema, to run
# the schema and the isolation tests against the real project instead of the
# local engine, and by scripts/provision.mjs to apply the schema.
DATABASE_URL=

# The password given to the nine demo seat accounts by
# scripts/seed-users.mjs. It is the owner's to choose and the owner's to hand
# out. The script never prints it.
DEMO_PASSWORD=

# A personal access token for the Management API, from the account tokens
# page. Used only by scripts/provision.mjs, to enable the access token hook,
# set the token lifetime and create the storage bucket. It is account wide, so
# it is the most sensitive value in this file.
SUPABASE_ACCESS_TOKEN=

# The project reference, the subdomain of the project URL. Used only by
# scripts/provision.mjs to address the project on the Management API.
SUPABASE_PROJECT_REF=
