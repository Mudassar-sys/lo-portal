# Copy to .env.local and paste the values from the Supabase dashboard.
# .env.local is gitignored. Never commit a key.

# Project URL. Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Settings -> API Keys -> Publishable key.
# Safe in a browser bundle. This replaces the deprecated legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Settings -> API Keys -> Secret keys.
# Server side only, and inside this repository it is read by the seed script
# alone. It must never reach a browser bundle. This replaces the deprecated
# legacy service_role key.
SUPABASE_SECRET_KEY=

# Public base URL of the deployment, used to build branded intake links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
