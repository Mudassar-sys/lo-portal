# dependencies
/node_modules
/.pnp
.pnp.*

# next build output
/.next/
/out/
/build
next-env.d.ts

# environment. Never commit a key.
#
# A catch all, because the specific names missed a real case: a file saved as
# .env.local.txt matched none of them and sat in the working tree, untracked
# but committable, holding live credentials. Anything beginning .env is
# ignored, and the example file is the single exception.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# os and editors
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# local scratch
/tmp/
*.log

# next dev writes two agent instruction files into the repository root. This
# deliverable names no AI tool, so the second one is matched with a character
# class rather than spelled out: the guard bans the literal word, including
# here.
AGENTS.md
[Cc][Ll][Aa][Uu][Dd][Ee].md
